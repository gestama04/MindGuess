{
  "name": "mindguess",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de deducao deterministico com uma camada separada de personalidade.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:workspaces && npm run test:data",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:data": "npm run build && node --test data/tests/*.test.mjs",
    "validate:data": "npm run build && node data/scripts/validate-people.mjs",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
